NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=xxxxxxxx
NEO4J_PASSWORD=your-aura-password-here
NEO4J_DATABASE=xxxxxxxx
FRONTEND_URL=http://localhost:5173
PORT=3001

# Groq API key — server-only, proxied via /api/groq/chat (never exposed to the browser)
GROQ_KEY=gsk_xxxxxxxx
# Gemini key for embeddings / semantic search (optional)
GEMINI_KEY=AIzaxxxxxxxx
# Shared secret guarding the destructive admin endpoints (clear / seed-bridges)
ADMIN_KEY=change-me-to-a-long-random-string

# Published Aura Agent (hackathon showcase). When both are set, demo-user chat
# routes through the published agent; everything else stays on the Groq path.
AURA_AGENT_ENDPOINT=https://api.neo4j.io/v2beta1/organizations/<org>/projects/<project>/agents/<agent-id>/invoke
AURA_AGENT_KEY=your-aura-agent-api-key
